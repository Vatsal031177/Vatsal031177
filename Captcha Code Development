from flask import Flask, session, render_template, request, redirect, url_for, send_file
from PIL import Image, ImageDraw, ImageFont
import random
import string
import io
import os

app = Flask(__name__)
app.secret_key = 'your_secret_key'  # Change this to a secure value

def generate_captcha_text(length=5):
    return ''.join(random.choices(string.ascii_uppercase + string.digits, k=length))

def generate_captcha_image(text):
    width, height = 150, 60
    image = Image.new('RGB', (width, height), color=(255, 255, 255))
    font = ImageFont.truetype("arial.ttf", 40)  # Ensure 'arial.ttf' is available or use another

    draw = ImageDraw.Draw(image)
    for i in range(random.randint(1, 5)):
        # Add noise lines
        draw.line(
            (random.randint(0, width), random.randint(0, height),
             random.randint(0, width), random.randint(0, height)),
            fill=(random.randint(0, 255), random.randint(0, 255), random.randint(0, 255)), width=2
        )

    draw.text((10, 10), text, font=font, fill=(0, 0, 0))

    byte_io = io.BytesIO()
    image.save(byte_io, 'PNG')
    byte_io.seek(0)
    return byte_io

@app.route('/')
def index():
    return render_template('index.html')

@app.route('/captcha')
def captcha():
    text = generate_captcha_text()
    session['captcha'] = text
    img = generate_captcha_image(text)
    return send_file(img, mimetype='image/png')

@app.route('/validate', methods=['POST'])
def validate():
    user_input = request.form['captcha']
    if user_input.upper() == session.get('captcha', ''):
        return "✅ CAPTCHA Passed!"
    else:
        return "❌ CAPTCHA Failed. Try again."

if __name__ == '__main__':
    app.run(debug=True)

